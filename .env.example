# ===================================================
# FashionCart Environment Configuration Template
# ===================================================

PORT=5000

# To use MongoDB Atlas Free Tier:
# 1. Create a free cluster on https://cloud.mongodb.com
# 2. Add a Database User with readWriteAnyDatabase or readWrite privileges
# 3. Add IP Access List 0.0.0.0/0 (allow access from anywhere) in Network Access
# 4. Copy connection string and replace <username> and <password> below:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fashioncart?retryWrites=true&w=majority

# JWT Token Signing Secret
JWT_SECRET=supersecretfashioncartjwtkey2026_supersecure

# Environment Mode
NODE_ENV=development
